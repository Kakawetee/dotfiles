// -*- mode: jsonc -*-
{
    // "layer": "top", // Waybar at top layer
    // "position": "bottom", // Waybar position (top|bottom|left|right)
    "height": 30, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 4, // Gaps between modules (4px)
    // Choose the order of the modules
    "modules-left": [
	"custom/launcher",
	"cpu",
	"memory",
	"custom/gpu"

    ],
    "modules-center": [ 
    	// "niri/window",
    	"mpris"
    ],
    "modules-right": [
        "pulseaudio",
	"bluetooth",
	"network",
	"custom/ethname",
	"clock"
    ],
    "custom/launcher": {
	"format": " " ,
	"tooltip": false,
	"on-click": "fuzzel"
    },
    "clock": {
        "format": "<span rise='750'>󰥔 </span>{:%H:%M}",
        "format-alt": "\uf073  {:%Y-%m-%d}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "cpu": {
        "format": "{usage}% \uf2db",
        "tooltip": false
    },

    "memory": {
        "format": "{}% <span rise='800'></span>"
    },
    "custom/gpu": {
    	"exec": "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits",
	"interval": 2,
	"format": "{}% <span font_size='x-large'>󰢮 </span>",
	"tooltip": false,
	"on-click": "nvidia-settings"
    },
    // Since I use Ethernet I dont really care about this
    "network": {
   	"format-wifi": "\uf1eb {essid} {signalStrength}%",
   	"format-ethernet": "", //"<span font_size='large' rise='-200'>󰈀 </span>{ifname}",
  	"format-disconnected": "\uf071 Sin red",
  	"tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
	"tooltip-format-ethernet": "{ifname}\n{ipaddr}"
    },
    "custom/ethname": {
   	"exec": "nmcli -t -f TYPE,NAME connection show --active | awk -F: '$1==\"802-3-ethernet\"{print $2; exit}'",
    	"interval": 5,
    	"escape": true,
    	"format": "<span font_size='large' rise='-200'>\udb80\ude00</span> {}",
    	"tooltip": false
    },
    "bluetooth": {
    	"format-off": "\udb80\udcb2 off",
    	"format-on": "\udb80\udcaf on",
    	"format-connected": "\udb80\udcb1 {device_alias}",
    	"format-disabled": "\udb80\udcb2 n/a",
    	"tooltip-format": "{controller_alias}\t{controller_address}",
    	"tooltip-format-connected": "{controller_alias}\n{device_enumerate}",
    	"tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    	"on-click": "bluetoothctl power $(bluetoothctl show | grep -q 'Powered: yes' && echo off || echo on)"
    },
    "pulseaudio": {
        "format": "{icon} {volume}% {format_source}",
        "format-muted": "\uf6a9 mute {format_source}",
	"format-source": "\uf130 {volume}%",
        "format-source-muted": "\uf131",
        "format-icons": {
            "default": ["\uf026", "\uf027", "\uf028"]
        },
        "on-click": "pavucontrol"
    },
    "mpris": {
	"format": "{status_icon}{dynamic}",
	"status-icons": {
		"playing": " ",
		"paused": " "
	},
	"dynamic-order": ["title", "artist"],
	"dynamic-len": 40,
	"tooltip-format": "{player}: {artist} - {title}",
	"on-click": "playerctl play-pause",
	"on-click-right": "playerctl next",
	"on-click-middle": "playerctl previous"

    }
}
