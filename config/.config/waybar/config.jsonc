// -*- mode: jsonc -*-
{
    // "layer": "top", // Waybar at top layer
    // "position": "bottom", // Waybar position (top|bottom|left|right)
    "height": 40, // Waybar height (to be removed for auto height)
    "spacing": 4, // Gaps between modules (4px)
    "layer": "top",
    "position": "top",
   
    
    "modules-left": [
	"custom/launcher",
	"custom/sep",
	"cpu",
	"memory",
	"custom/gpu",


    ],
    "modules-center": [ 
	"mpris",
	"custom/sep#2",
    	"niri/window"
    ],
    "modules-right": [
        "pulseaudio",
	"network",
	"custom/ethname",
	"clock",
	"custom/sep#1",
	"custom/power",
	"custom/lock"
    ],
    "custom/launcher": {
	"format": "<span font_size='x-large'></span> " ,

	"tooltip": false,
	"on-click": "fuzzel"
    },
    "clock": {
        "format": "<span rise='750'>󰥔 </span>{:%H:%M}",
        "format-alt": "\uf073  {:%Y-%m-%d}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "cpu": {
        "format": "{usage}% <span rise='600'>\uf2db</span>",
        "tooltip": false
    },

    "memory": {
        "format": "{}% <span rise='800'> </span>"
    },
    "custom/gpu": {
    	"exec": "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits",
	"interval": 2,
	"format": "{}% <span rise='-600' font_size='x-large'>󰢮 </span>",
	"tooltip": false,
	"on-click": "nvidia-settings"
    },
    // Since I use Ethernet I dont really care about this
    "network": {
   	"format-wifi": "\uf1eb {essid} {signalStrength}%",
   	"format-ethernet": "", //"<span font_size='large' rise='-200'>󰈀 </span>{ifname}",
  	"format-disconnected": "\uf071 Sin red",
  	"tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
	"tooltip-format-ethernet": "{ifname}\n{ipaddr}",
    	"on-click": "nm-connection-editor"
    },
    "custom/ethname": {
   	"exec": "nmcli -t -f TYPE,NAME connection show --active | awk -F: '$1==\"802-3-ethernet\"{print $2; exit}'",
    	"interval": 5,
    	"escape": true,
    	"format": "<span font_size='medium' rise='150'>\udb80\ude00 </span> {}",
    	"on-click": "nm-connection-editor"
    },
    "pulseaudio": {
        "format": "{icon}  {volume}% {format_source}",
        "format-muted": "\uf6a9 mute {format_source}",
	"format-source": "\uf130 {volume}%",
        "format-source-muted": "\uf131",
        "format-icons": {
            "default": ["\uf026", "\uf027", "\uf028"]
        },
        "on-click": "pavucontrol"
    },
    "mpris": {
	"format": "{status_icon} {dynamic}",
	"status-icons": {
		"playing": " ",
		"paused": " "
	},
	"dynamic-order": ["title", "artist"],
	"dynamic-len": 40,
	"tooltip-format": "{player}: {artist} - {title}",
	"on-click": "playerctl play-pause",
	"on-click-right": "playerctl next",
	"on-click-middle": "playerctl previous"

    },
    "group/power": {
	"orientation": "inherit",
	"drawer": {
		"transition-duration": 300,
		"children-class": "power-child",
		"transition-left-to-right": true,
		"click-to-reveal": true
	},
	"modules": [
		"custom/menu",
		"custom/power",
		"custom/reboot",
		"custom/suspend"
	]
    },
    "custom/power": {
	"format": "\uf011",
	"tooltip": false,
	"menu": "on-click",
	"menu-file": "~/.config/waybar/power_menu.xml",
	"menu-actions": {
        	"shutdown": "systemctl poweroff",
        	"reboot": "systemctl reboot",
       		"suspend": "systemctl suspend"
    	}
    },
    "custom/lock": {
	"format": "\uf023",
	"tooltip": false,
	"on-click": "swaylock"
    },
    "custom/sep": {
	"format": "<span font_size='x-large'>•</span>",
	"tooltip": false
    },
    "custom/sep#1": {
	"format": "<span font_size='x-large'>•</span>",
	"tooltip": false
    },
     "custom/sep#2": {
	"exec": "~/.config/waybar/mpris-sep.sh",
     	"format": "{}",
     	"tooltip": false
     }
}
